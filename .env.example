# ============================================================
# ImobFlow — Variáveis de Ambiente
# Copie para .env e preencha — NUNCA suba .env para o GitHub!
# ============================================================

# Flask
SECRET_KEY=dev-secret-mude-em-producao-123456

# Criptografia AES-256 (LGPD) — valor EXATO de Fernet.generate_key().decode()
# Deixe vazio em dev — será gerada automaticamente (não use em produção)
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Chave inválida: em produção o app não inicia; em FLASK_DEBUG=true usa chave temporária.
ENCRYPTION_KEY=

# Banco de dados
# Em dev: deixe comentado — usa SQLite automaticamente
# Em produção no Railway: use ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:senha@host:5432/banco

# Modo debug
FLASK_DEBUG=true

# Stripe — pagamentos (veja docs/MONETIZACAO_E_SAAS.md)
# STRIPE_SECRET_KEY=sk_test_SUA_CHAVE_AQUI
# STRIPE_WEBHOOK_SECRET=whsec_SUA_CHAVE_AQUI
# IDs dos preços no Dashboard Stripe (Products → Price → price_...)
# STRIPE_PRICE_ID_PRO=price_xxxxxxxx
# STRIPE_PRICE_ID_GESTORA=price_yyyyyyyy

# Anúncios Google AdSense — só usuários plano Free (opcional)
# SHOW_ADS_ON_FREE_PLAN=false
# GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxx
# GOOGLE_ADSENSE_SLOT=1234567890

# n8n Webhooks (opcional)
# N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/imobflow
# N8N_WEBHOOK_SECRET=string-aleatoria-secreta
