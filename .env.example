# ─── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_DB=imobflow
POSTGRES_USER=imobflow_user
POSTGRES_PASSWORD=troque-por-senha-forte-aqui

# ─── Flask ───────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere-uma-chave-aleatoria-aqui
FLASK_DEBUG=false

# ─── Criptografia de campos sensíveis (LGPD) ─────────────────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gere-uma-chave-fernet-aqui

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── n8n Webhooks ────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/imobflow
N8N_WEBHOOK_SECRET=gere-um-segredo-para-validar-webhooks

# ── Google OAuth (Login com Google) ──────────────────────────────────────────
# 1. Acesse: console.cloud.google.com
# 2. Crie um projeto → APIs & Services → Credentials → OAuth 2.0 Client ID
# 3. Em "Authorized redirect URIs" adicione:
#    - http://localhost:5000/login/google/callback  (dev)
#    - https://seudominio.com/login/google/callback (produção)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
